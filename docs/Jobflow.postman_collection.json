                  "key": "category",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "company",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "location",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "full_time,internship",
                  "disabled": true
                },
                {
                  "key": "mode",
                  "value": "remote,hybrid",
                  "disabled": true
                },
                {
                  "key": "salaryMin",
                  "value": "100000",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "newest",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": false
                }
              ]
            },
            "description": "Saves the first result's id into {{jobId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data[0] && j.data[0].id;",
                  "if (v) pm.collectionVariables.set('jobId', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get job",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
