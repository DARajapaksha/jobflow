        {
          "name": "Update status (employer)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}",
                "status"
              ]
            },
            "description": "Allowed: submitted -> reviewed|rejected, reviewed -> shortlisted|rejected, shortlisted -> hired|rejected.",
            "body": {
              "mode": "raw",
