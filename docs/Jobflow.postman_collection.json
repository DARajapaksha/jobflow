    {
      "name": "Applications",
      "item": [
        {
          "name": "Apply to job (seeker)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}",
                "applications"
              ]
            },
            "description": "Enable the 'resume' file to upload a PDF; leave it disabled to use your saved default resume.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "coverLetter",
                  "value": "I would love to join the team.",
                  "type": "text"
                },
                {
                  "key": "resume",
                  "type": "file",
                  "src": [],
                  "disabled": true
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.application && j.application.id;",
                  "if (v) pm.collectionVariables.set('applicationId', v);"
                ]
              }
            }
          ]
        },
        {
