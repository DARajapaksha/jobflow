              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}",
                "applications"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "submitted",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": false
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data[0] && j.data[0].id;",
                  "if (v) pm.collectionVariables.set('applicationId', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "Application detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}"
              ]
            }
          }
        },
        {
          "name": "Update status (employer)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}",
                "status"
              ]
            },
            "description": "Allowed: submitted -> reviewed|rejected, reviewed -> shortlisted|rejected, shortlisted -> hired|rejected.",
            "body": {
