    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            }
          }
        },
        {
          "name": "Search jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs?q=developer&category=&location=&type=full_time,internship&mode=remote,hybrid&salaryMin=100000&sort=newest&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "developer",
                  "disabled": false
                },
                {
                  "key": "category",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "location",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "full_time,internship",
                  "disabled": true
                },
                {
                  "key": "mode",
                  "value": "remote,hybrid",
                  "disabled": true
                },
                {
                  "key": "salaryMin",
                  "value": "100000",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "newest",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": false
                }
              ]
            },
            "description": "Saves the first result's id into {{jobId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data[0] && j.data[0].id;",
                  "if (v) pm.collectionVariables.set('jobId', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get job",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            }
          }
        },
        {
          "name": "Create job (employer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Junior Developer\",\n  \"description\": \"Work on our web platform with a friendly team.\",\n  \"location\": \"Colombo\",\n  \"categoryId\": 1,\n  \"jobType\": \"full_time\",\n  \"workMode\": \"hybrid\",\n  \"salaryMin\": 100000,\n  \"salaryMax\": 150000,\n  \"status\": \"open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.job && j.job.id;",
                  "if (v) pm.collectionVariables.set('jobId', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update job (employer)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Junior Developer (updated)\",\n  \"salaryMax\": 170000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Close job (employer)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"closed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete job (employer)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            }
          }
        },
        {
          "name": "My listings (employer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employer/jobs?status=open",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employer",
                "jobs"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Resume (seeker)",
      "item": [
        {
          "name": "Upload default resume",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/resume",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me",
                "resume"
              ]
            },
            "description": "Body > form-data: pick a PDF for the 'resume' field.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "resume",
                  "type": "file",
                  "src": []
                }
              ]
